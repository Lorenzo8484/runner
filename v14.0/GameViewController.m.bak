// ─── Game Constants ──────────────────────────
#define LANE_W 2.5f
#define LX(l) ((l)*LANE_W)
#define RW (LANE_W*3.6f)
#define TL 8.0f
#define NT 30
#define SHADOW_SZ 2048
#define MAX_LIVES 5

// ─── State Machine ───────────────────────────
